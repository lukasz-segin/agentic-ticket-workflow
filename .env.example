# Copy to .env to override. docker-compose.yml has the same values as inline
# defaults, so `docker compose up` works without a .env. No real secrets here.

# Temporal (use localhost:7233 when running the api/worker outside compose)
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tickets

# LLM_MODE: fake | openai. "fake" = rule-based, no network, no key.
# "openai" = any OpenAI-compatible endpoint; it needs LLM_BASE_URL and
# LLM_MODEL, e.g. LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4.1-mini. LLM_API_KEY may
# stay empty for local servers such as Ollama. See README "Real model".
LLM_MODE=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Fake helpdesk: probability (0..1) that a call fails temporarily
HELPDESK_FAILURE_RATE=0.3

LOG_LEVEL=INFO
